# ── Environment ────────────────────────────────────────────────────────────────
# "development" loads .env  |  "production" loads .env.production
ENV=development
DEBUG=true

# ── API Keys ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ── Models ─────────────────────────────────────────────────────────────────────
EXTRACTION_MODEL=claude-haiku-4-5
REASONING_MODEL=claude-sonnet-4-5
EXTRACTION_TEMPERATURE=0.2
EXTRACTION_MAX_TOKENS=1000
REASONING_TEMPERATURE=0.7
REASONING_MAX_TOKENS=2000

# ── Pipeline Thresholds ────────────────────────────────────────────────────────
RETRIEVAL_MIN_SCORE=0.35
TOP_K_RETRIEVAL=3
CONFIDENCE_THRESHOLD=0.7
INJECTION_THRESHOLD=0.75
GROUNDEDNESS_THRESHOLD=0.6
GROUNDEDNESS_MODEL=cross-encoder/nli-deberta-v3-base

# ── Storage ────────────────────────────────────────────────────────────────────
CHROMA_PATH=./data/chroma
AUDIT_LOG_PATH=./data/audit

# ── Demo UI ────────────────────────────────────────────────────────────────────
API_URL=http://127.0.0.1:8000

# ── Observability (optional — needed with langfuse extra) ──────────────────────
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-replace
# LANGFUSE_SECRET_KEY=sk-lf-replace
