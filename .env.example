# ── Environment ────────────────────────────────────────────────────────────────
# "production" loads .env.production when present; otherwise it uses real environment variables only and never falls back to .env
ENV=development
DEBUG=true

# ── API Keys ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
FEATHERLESS_API_KEY=your_featherless_api_key_here

# ── LLM Provider ───────────────────────────────────────────────────────────────
# anthropic | openai_compatible  (openai_compatible = Featherless / event credits)
LLM_PROVIDER=anthropic
OPENAI_COMPATIBLE_BASE_URL=https://api.featherless.ai/v1

# ── Models ─────────────────────────────────────────────────────────────────────
EXTRACTION_MODEL=claude-haiku-4-5
REASONING_MODEL=claude-sonnet-4-5
EXTRACTION_TEMPERATURE=0.0
EXTRACTION_MAX_TOKENS=1000
# Grounded QA must be deterministic — keep reasoning temperature at 0.0
REASONING_TEMPERATURE=0.0
REASONING_MAX_TOKENS=2000

# ── Pipeline Thresholds ────────────────────────────────────────────────────────
RETRIEVAL_MIN_SCORE=0.35
TOP_K_RETRIEVAL=3
CONFIDENCE_THRESHOLD=0.7
INJECTION_THRESHOLD=0.75
GROUNDEDNESS_THRESHOLD=0.6

# ── Guardrail Modes ────────────────────────────────────────────────────────────
# flag_only = score and log, never block (use while tuning) | block = refuse
INJECTION_MODE=block

# ── Prompting ──────────────────────────────────────────────────────────────────
SYSTEM_PROMPT=

# ── Storage ────────────────────────────────────────────────────────────────────
CHROMA_PATH=./data/chroma
AUDIT_LOG_PATH=./data/audit

# ── Demo UI ────────────────────────────────────────────────────────────────────
API_URL=http://127.0.0.1:8000

# ── Observability (optional — needed with langfuse extra) ──────────────────────
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-replace
# LANGFUSE_SECRET_KEY=sk-lf-replace
